:root{--bg:#03111d;--panel:#061a2a;--panel2:#082239;--line:rgba(160,205,225,.16);--text:#f4f7f8;--muted:#93a8b7;--gold:#f3b63d;--cyan:#2ed7d0;--green:#20c997;--blue:#3995ef;--red:#ed6271;--purple:#a86eea;--shadow:0 18px 45px rgba(0,0,0,.3);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}*{box-sizing:border-box}html,body,#app{margin:0;min-height:100%;background:var(--bg);color:var(--text)}button,input,select{font:inherit}button{cursor:pointer;color:inherit}button:disabled{cursor:not-allowed;opacity:.42}.game{min-height:100vh;display:grid;grid-template-columns:225px 1fr;background:radial-gradient(circle at 80% 0%,rgba(27,89,116,.2),transparent 35%),#03111d}.sidebarwrap{min-width:0}.sidebar{position:sticky;top:0;height:100vh;display:flex;flex-direction:column;background:linear-gradient(180deg,#06182a,#041321);border-right:1px solid var(--line);padding:20px 13px 16px;z-index:10}.brand{text-align:center;padding:3px 0 25px;border-bottom:1px solid var(--line)}.brand h1{font-family:Georgia,serif;font-size:29px;line-height:.92;letter-spacing:.02em;margin:0;color:#f6f1df}.brand p{margin:12px 0 0;color:#c4d0d8;font-size:13px}.sidebar nav{padding:10px 0;display:grid;gap:3px}.sidebar nav button{height:43px;border:0;background:transparent;border-left:3px solid transparent;border-radius:0 7px 7px 0;display:flex;align-items:center;gap:14px;padding:0 12px;color:#b4c3ce;text-align:left}.sidebar nav button i{font-style:normal;font-size:19px;width:22px;text-align:center}.sidebar nav button span{font-size:14px}.sidebar nav button.active{background:linear-gradient(90deg,rgba(18,111,160,.38),rgba(18,111,160,.08));border-left-color:var(--gold);color:#fff}.quick{margin-top:auto;border:1px solid var(--line);border-radius:9px;padding:12px 10px;display:grid;gap:8px;background:rgba(0,0,0,.13)}.quick small{font-weight:700;margin-bottom:2px}.gold,.outline,.darkfull{border:0;border-radius:6px;min-height:38px;padding:0 15px;font-weight:800}.gold{background:linear-gradient(180deg,#ffd36a,#eca52c);color:#09141d;box-shadow:0 5px 16px rgba(243,182,61,.18)}.outline{background:transparent;border:1px solid #2d5874}.credits{margin-top:14px;padding:10px 3px;color:#8195a3;font-size:10px;line-height:1.65}.credits a{color:#9eb2c0;text-decoration:none}.credits a:hover{text-decoration:underline}.gamearea{min-width:0}.topbar{height:68px;display:flex;align-items:center;justify-content:flex-end;padding:10px 16px;border-bottom:1px solid var(--line);background:#041523;position:sticky;top:0;z-index:9}.mobilebrand{display:none}.topstats{display:flex;align-items:center;gap:0;border:1px solid var(--line);border-radius:8px;overflow:hidden;background:rgba(3,17,29,.8)}.topstats>div{min-width:145px;padding:7px 15px;border-right:1px solid var(--line);display:grid;grid-template-columns:24px 1fr;column-gap:5px}.topstats>div:last-child{border:0}.topstats b{grid-row:span 2;font-size:22px;color:var(--gold)}.topstats span{font-weight:700;font-size:14px}.topstats small{color:var(--green);font-size:10px}.datebox{min-width:165px!important}.datebox small{color:#d2d8a0}.maincontent{padding-bottom:35px}.hero{height:330px;position:relative;overflow:hidden;border-bottom:1px solid var(--line)}.hero>img{width:100%;height:100%;object-fit:cover;object-position:center 44%;display:block}.herooverlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(2,15,27,.94) 0%,rgba(2,15,27,.72) 24%,rgba(2,15,27,.12) 65%,rgba(2,15,27,.35) 100%),linear-gradient(0deg,rgba(3,17,29,.75),transparent 55%)}.welcome{position:absolute;left:40px;top:34px;width:360px}.welcome small,.pagehead small,.paneltitle h2,.stage small,.next small{letter-spacing:.03em}.welcome>small{font-size:17px;color:#e8eef2}.welcome h1{font-family:Georgia,serif;font-size:52px;line-height:1;margin:5px 0}.welcome p{margin:0 0 17px;font-size:17px;color:#e0e8ed}.nationcard{width:310px;display:flex;gap:13px;padding:14px;background:rgba(3,18,30,.9);border:1px solid rgba(160,205,225,.2);border-radius:7px}.emblem{width:56px;height:56px;border-radius:3px;display:grid;place-items:center;background:linear-gradient(135deg,#5aa9ef,#2875d7);font-size:29px}.nationcard>div:last-child{flex:1}.nationcard b{display:block;font-size:16px}.nationcard span,.nationcard small{display:block;color:#cad6de;font-size:11px;margin-top:2px}.nationcard small{margin-top:5px}.nationcard em{font-size:9px;color:#aab8c0;font-style:normal}.bar{height:8px;background:#183247;border-radius:99px;overflow:hidden;margin:6px 0 3px}.bar i{display:block;height:100%;background:linear-gradient(90deg,#42c4e8,#7ad8f1);border-radius:inherit}.continue{margin-top:11px;width:310px}.metrics{position:absolute;left:38%;bottom:24px;display:grid;grid-template-columns:repeat(4,1fr);gap:5px;width:520px}.metrics>div{min-width:0;background:rgba(3,18,30,.92);border:1px solid rgba(160,205,225,.18);border-radius:7px;padding:10px 11px;display:grid;grid-template-columns:25px 1fr}.metrics b{grid-row:span 3;color:var(--gold);font-size:22px}.metrics small{font-size:9px;color:#9fb0bb}.metrics strong{font-size:16px}.metrics em{font-size:9px;color:var(--green);font-style:normal}.away{position:absolute;right:17px;top:68px;width:300px;padding:14px;border:1px solid rgba(160,205,225,.2);border-radius:8px;background:rgba(3,18,30,.93);box-shadow:var(--shadow)}.away h3{font-size:15px;margin:0 0 12px}.away div{font-size:11px;padding:7px 0;border-bottom:1px solid rgba(160,205,225,.08);color:#bdcbd3}.away div b{color:#49dc96;margin:0 7px}.away .gold{width:100%;margin-top:11px}.dashboardgrid{display:grid;grid-template-columns:1.08fr 1.08fr 1.05fr .94fr .88fr;gap:10px;padding:13px 13px 0}.panel{background:linear-gradient(180deg,rgba(6,29,46,.98),rgba(4,21,34,.98));border:1px solid var(--line);border-radius:8px;box-shadow:0 8px 22px rgba(0,0,0,.15);min-width:0}.paneltitle{display:flex;align-items:center;justify-content:space-between;padding:11px 13px;border-bottom:1px solid rgba(160,205,225,.1)}.paneltitle h2{font-size:13px;margin:0}.paneltitle button{border:0;background:transparent;color:#3bd2ff;font-size:10px}.skillrow{display:grid;grid-template-columns:39px 1fr 70px;gap:8px;align-items:center;padding:7px 9px;border-bottom:1px solid rgba(160,205,225,.07)}.skillicon{width:39px;height:39px;border-radius:7px;display:grid;place-items:center;font-size:21px}.skillicon.gold{background:#6f5220;color:#ffd26c}.skillicon.blue{background:#17589b;color:#d8eeff}.skillicon.green{background:#0a7a65;color:#a7ffe9}.skillicon.cyan{background:#0d6f9b;color:#b9f1ff}.skillicon.red{background:#a6344d;color:#ffd7de}.skillicon.teal{background:#137b79;color:#c8ffff}.skillicon.purple{background:#7040a1;color:#ead5ff}.skilltxt b{display:block;font-size:11px}.skilltxt span{display:block;font-size:9px;color:#c0d1db}.skilltxt small{display:block;font-size:8px;color:#37d8c8}.skillrow button,.buildingrow button,.storeitem button{border:0;border-radius:6px;background:linear-gradient(180deg,#20c89b,#119f7c);color:#fff;font-size:9px;font-weight:800;padding:6px 5px}.skillrow button em,.buildingrow button em{display:block;color:#bfe8dd;font-size:8px;font-style:normal;margin-top:2px}.filters{display:flex;gap:4px;overflow:auto;padding:8px}.filters button{border:1px solid #28485e;background:#092035;color:#a9bac5;border-radius:12px;padding:5px 8px;font-size:8px;white-space:nowrap}.filters button.active{color:#fff;border-color:#55b9df}.storeitem{display:grid;grid-template-columns:50px 1fr 58px 39px;align-items:center;gap:6px;padding:6px 8px;border-bottom:1px solid rgba(160,205,225,.07)}.thumb{height:45px;border-radius:5px;background-size:600% 100%;background-repeat:no-repeat;background-color:#18344b}.storetxt b{display:block;font-size:10px}.storetxt small{display:block;font-size:8px;color:#2ed7c5}.storeitem strong{font-size:9px;text-align:right}.storeitem button{padding:7px 4px;text-transform:capitalize}.cityimage{position:relative;margin:9px 9px 0;height:90px;overflow:hidden;border-radius:5px}.cityimage img{width:100%;height:100%;object-fit:cover}.cityimage span{position:absolute;right:6px;bottom:6px;background:#0b263b;border:1px solid #2d5874;border-radius:12px;padding:4px 7px;font-size:8px}.cityhead{padding:7px 10px}.cityhead b{display:block;font-size:12px}.cityhead small{display:block;color:#9cb0bb;font-size:8px;margin-top:2px}.citystats{display:grid;grid-template-columns:repeat(3,1fr);gap:3px;padding:0 9px}.citystats>div{padding:7px;background:#092137;border:1px solid rgba(160,205,225,.08);font-size:11px}.citystats small,.citystats b,.citystats em{display:block}.citystats small{font-size:7px;color:#8ea1ad}.citystats b{font-size:10px}.citystats em{font-size:7px;color:#3cdb9a;font-style:normal}.city-panel h3{font-size:10px;padding:0 10px;margin:11px 0 5px}.buildingrow{display:grid;grid-template-columns:28px 1fr 62px;gap:6px;align-items:center;padding:6px 9px;border-top:1px solid rgba(160,205,225,.07)}.buildingrow>span{font-size:18px}.buildingrow b{display:block;font-size:9px}.buildingrow small{display:block;color:#8da3b0;font-size:7px}.buildingrow button{font-size:8px}.stage{padding:13px}.stage small,.next small{font-size:8px;color:#9eb0ba}.stage b{display:block;font-size:16px;margin-top:4px}.stage span{display:inline-block;font-size:9px;color:#4fc9f0;margin:3px 0}.stage em{font-size:8px;color:#8da1ad;font-style:normal}.next{border-top:1px solid rgba(160,205,225,.08);padding:12px}.next h3{font-size:12px;margin:5px 0}.next p{font-size:8px;color:#9fb0ba;margin:9px 0 4px}.next>div{font-size:8px;padding:3px 0;color:#d0dbe1}.next hr{border:0;border-top:1px solid rgba(160,205,225,.08);margin:8px 0}.next .gold{width:100%;margin-top:9px}.diplomacy{display:flex;gap:8px;align-items:center;padding:10px;font-size:20px}.diplomacy span{font-size:10px;flex:1}.diplomacy small{font-size:8px;color:#9fb0ba}.relation{display:grid;grid-template-columns:24px 1fr auto;align-items:center;gap:5px;padding:8px 10px;border-top:1px solid rgba(160,205,225,.07)}.relation b{font-size:8px}.relation small{font-size:7px;color:#39d99a}.relation small.bad{color:#f16d76}.darkfull{margin:8px;width:calc(100% - 16px);background:#09263c;border:1px solid #31546d;font-size:8px}.achievements{margin-top:10px}.achievements>div:not(.paneltitle){display:grid;grid-template-columns:26px 1fr auto;gap:6px;align-items:center;padding:8px;border-top:1px solid rgba(160,205,225,.07)}.achievements section b,.achievements section small{display:block}.achievements section b{font-size:8px}.achievements section small{font-size:7px;color:#8ea3ae}.achievements em{font-size:8px;color:#3cdb9a;font-style:normal}.lowergrid{display:grid;grid-template-columns:1.7fr .9fr 1.15fr;gap:10px;padding:10px 13px}.nodes{display:flex;justify-content:space-around;padding:15px 10px 13px;position:relative}.nodes:before{content:"";position:absolute;left:8%;right:8%;top:29px;border-top:2px solid #27445b}.node{position:relative;z-index:1;text-align:center;width:12%}.node span{width:29px;height:29px;margin:auto;display:grid;place-items:center;border-radius:50%;background:#12283b;border:1px solid #3b5263;color:#8094a0;font-size:12px}.node.done span{background:#6e5426;border-color:#d9a938;color:#fff}.node.current span{box-shadow:0 0 0 3px rgba(243,182,61,.14)}.node b,.node small{display:block}.node b{font-size:8px;margin-top:5px}.node small{font-size:7px;color:#8ea2ad}.activity>div:not(.paneltitle){display:grid;grid-template-columns:22px 1fr auto;gap:7px;padding:8px 10px;border-bottom:1px solid rgba(160,205,225,.07);font-size:8px}.activity small{color:#728896}.buildtomorrow{position:relative;overflow:hidden;min-height:130px}.buildtomorrow img{width:100%;height:100%;position:absolute;inset:0;object-fit:cover;opacity:.48}.buildtomorrow>div{position:relative;padding:17px}.buildtomorrow h2{font-family:Georgia,serif;font-size:18px;margin:0}.buildtomorrow p{font-size:9px;color:#d1dbe0}.buildtomorrow .gold{min-width:130px}.subpage{padding:25px;min-height:calc(100vh - 68px);background:radial-gradient(circle at 75% 0%,rgba(24,85,113,.15),transparent 35%)}.pagehead{margin-bottom:18px}.pagehead h1{font-family:Georgia,serif;font-size:37px;margin:5px 0}.pagehead p{color:#8fa4b0;font-size:12px}.fullskills .skills-panel{max-width:900px}.fullstore{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.bigstore{display:grid;grid-template-columns:100px 1fr auto auto;gap:13px;align-items:center;padding:10px;background:var(--panel);border:1px solid var(--line);border-radius:8px}.bigstore .thumb{height:82px}.bigstore h2{font-size:14px;margin:0}.bigstore p{font-size:9px;color:#9fb0ba}.bigstore small{font-size:8px;color:#3ad7c6}.bigstore>strong{font-size:10px}.citiesfull{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.citylarge{background:var(--panel);border:1px solid var(--line);border-radius:8px;overflow:hidden}.citylarge img{width:100%;height:190px;object-fit:cover}.citylarge>div{padding:14px}.citylarge h2{font-size:20px;margin:5px 0}.citylarge p{font-size:10px;color:#9eb0bb}.fullprogress{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.pstage{padding:17px;background:var(--panel);border:1px solid var(--line);border-radius:8px;opacity:.55}.pstage.done{opacity:1;border-color:#466b78}.pstage span{color:var(--gold);font-size:10px}.pstage h2{font-family:Georgia,serif;font-size:18px;margin:9px 0}.pstage p,.pstage small{font-size:9px;color:#9fb0ba}.placeholder{max-width:700px;margin:80px auto;text-align:center;padding:60px 30px;background:var(--panel);border:1px solid var(--line);border-radius:12px}.placeholdericon{font-size:55px;color:var(--gold)}.placeholder h2{font-family:Georgia,serif;font-size:28px}.placeholder p{color:#95aab6;font-size:12px}.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);z-index:100;background:#09263b;border:1px solid #46708b;padding:12px 18px;border-radius:7px;box-shadow:var(--shadow);font-size:11px}.landing{min-height:100vh;position:relative;overflow:hidden;background:radial-gradient(circle at 70% 50%,rgba(38,115,125,.1),transparent 35%),#030a0f;display:flex;align-items:center;padding:7vw}.landing-copy{position:relative;z-index:2;width:min(610px,50vw)}.landing-copy>small{color:#7e9ba2;letter-spacing:.14em;font-size:10px}.landing-copy h1{font-family:Georgia,serif;font-size:clamp(60px,8vw,120px);line-height:.82;letter-spacing:-.05em;margin:18px 0}.landing-copy h1 span{color:#b9c7c8}.landing-copy p{max-width:540px;color:#9caeb2;font-size:15px;line-height:1.7}.landingbtn{margin-top:17px;border:0;border-radius:5px;background:linear-gradient(180deg,#e9fbfb,#9ed4d5);color:#071214;font-weight:900;padding:14px 20px;min-width:255px;box-shadow:0 8px 25px rgba(83,188,193,.18)}.landingbtn b{float:right}.landingnote{font-size:8px;color:#5d7479;letter-spacing:.12em;margin-top:14px}.landing-globe{position:absolute;right:2vw;top:50%;transform:translateY(-50%);width:min(56vw,760px);height:min(56vw,760px);opacity:.9}.landing-globe canvas{width:100%!important;height:100%!important}.landing .credits{margin-top:26px}.creator{min-height:100vh;display:grid;place-items:center;padding:40px 15px;background:radial-gradient(circle at 70% 10%,rgba(100,190,190,.08),transparent 35%),#050a0c}.creatorcard{width:min(820px,96vw);background:linear-gradient(145deg,#0c1b23,#071116);border:1px solid var(--line);border-radius:12px;padding:34px;box-shadow:var(--shadow)}.creatorhead h1{font-family:Georgia,serif;font-size:44px;margin:7px 0}.creatorhead p{color:#9caeb5}.creatorcard>label{display:block;color:#9eb0ba;font-size:11px;margin:13px 0}.creatorcard input,.creatorcard select{display:block;width:100%;margin-top:7px;padding:12px 13px;background:#07141d;color:#fff;border:1px solid #29465a;border-radius:6px;outline:none;font-size:15px}.creatorgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.presetrow{display:flex;gap:6px;overflow:auto;margin:20px 0}.presetrow button{white-space:nowrap;border:1px solid #29465a;background:#091a27;color:#b8c8d1;padding:8px 11px;border-radius:6px;font-size:10px}.createbtn{width:100%;margin-top:10px}.creator .credits{text-align:center}.@media(max-width:1250px){.game{grid-template-columns:190px 1fr}.dashboardgrid{grid-template-columns:repeat(3,1fr)}.dashboardgrid>div:nth-child(4){grid-column:span 1}.dashboardgrid>div:nth-child(5){grid-column:span 1}.metrics{left:35%;width:48%}.away{width:250px}.lowergrid{grid-template-columns:1fr 1fr}.buildtomorrow{grid-column:span 2}}@media(max-width:900px){.game{display:block}.sidebar{height:auto;position:sticky;top:0;padding:7px 10px;display:block}.brand{display:none}.sidebar nav{display:flex;overflow:auto}.sidebar nav button{min-width:78px;height:42px;justify-content:center;flex-direction:column;gap:1px;border-left:0;border-bottom:2px solid transparent;border-radius:6px;padding:2px}.sidebar nav button.active{border-bottom-color:var(--gold)}.sidebar nav button i{font-size:15px}.sidebar nav button span{font-size:9px}.quick,.sidebar .credits{display:none}.topbar{height:58px}.topstats{width:100%;justify-content:space-between}.topstats>div{min-width:0;flex:1;padding:5px 8px}.topstats .datebox{display:none}.hero{height:520px}.welcome{left:24px;top:28px}.away{right:15px;top:auto;bottom:20px;width:260px}.metrics{left:24px;bottom:180px;width:calc(100% - 48px)}.dashboardgrid{grid-template-columns:1fr 1fr}.dashboardgrid>div:nth-child(3),.dashboardgrid>div:nth-child(4),.dashboardgrid>div:nth-child(5){grid-column:span 2}.lowergrid{grid-template-columns:1fr}.buildtomorrow{grid-column:auto}.fullstore,.citiesfull{grid-template-columns:1fr}.fullprogress{grid-template-columns:repeat(2,1fr)}}@media(max-width:600px){.topstats>div:nth-child(3){display:none}.mobilebrand{display:block;font-weight:900;margin-right:auto;font-size:13px}.topbar{justify-content:flex-end}.hero{height:590px}.welcome{left:17px;right:17px;width:auto}.welcome h1{font-size:42px}.welcome p{font-size:14px}.nationcard,.continue{width:100%}.metrics{left:14px;right:14px;bottom:190px;width:auto;grid-template-columns:repeat(2,1fr)}.metrics>div{padding:8px}.away{left:14px;right:14px;bottom:12px;width:auto}.dashboardgrid{grid-template-columns:1fr;padding:9px}.dashboardgrid>div{grid-column:auto!important}.lowergrid{padding:9px}.nodes{overflow:auto;justify-content:flex-start;gap:25px}.node{min-width:72px}.subpage{padding:18px 12px}.pagehead h1{font-size:30px}.bigstore{grid-template-columns:72px 1fr auto}.bigstore button{grid-column:2 / 4}.creatorgrid{grid-template-columns:1fr}.creatorcard{padding:22px 16px}.creatorhead h1{font-size:34px}.landing{padding:28px 22px;align-items:flex-start}.landing-copy{width:100%;padding-top:8vh}.landing-copy h1{font-size:68px}.landing-copy p{font-size:13px}.landing-globe{width:520px;height:520px;right:-250px;top:56%;opacity:.3}.landing .credits{font-size:8px}.skillrow{grid-template-columns:39px 1fr 72px}.storeitem{grid-template-columns:48px 1fr 58px 38px}}
